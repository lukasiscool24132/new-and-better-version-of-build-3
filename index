<section id="gm" class="scr" aria-label="Games"><h2>खेल<span class="en">Side games</span></h2><p>एक खेल चुनो!<span class="en">Pick a game!</span></p><div id="gmg" class="gmg"></div></section>
<section id="gp" class="scr" aria-label="Game"><h2 id="gt" style="text-align:center"></h2><div id="gmsg" class="gmsg" aria-live="polite"></div><div id="gb"></div></section>

<div id="jk" class="jk" hidden role="dialog" aria-modal="true" aria-labelledby="jt"><div class="jc">
  <div class="jh f" id="jt">😂 चुटकुला टाइम!<span class="en">Joke Time!</span></div>
