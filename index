</div></div>

<script>
const $=id=>document.getElementById(id),pick=a=>a[Math.floor(Math.random()*a.length)],sh=a=>[...a].sort(()=>Math.random()-.5);
function speak(t){try{if(!window.speechSynthesis)return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.lang=LANG==="en"?"en-IN":"hi-IN";u.rate=.7;const f=speechSynthesis.getVoices().find(x=>new RegExp("^"+(LANG==="en"?"en":"hi"),"i").test(x.lang));if(f)u.voice=f;speechSynthesis.speak(u)}catch(e){}}
function load(){try{const s=JSON.parse(localStorage.getItem("basa"+(LANG==="en"?"-en":""))||"null");if(Array.isArray(s)&&s.length===25)return s}catch(e){}return Array(25).fill(0)}
function save(){try{localStorage.setItem("basa"+(LANG==="en"?"-en":""),JSON.stringify(prog))}catch(e){}}
let LANG=(()=>{try{return localStorage.getItem("basa-lang")==="en"?"en":"hi"}catch(e){return"hi"}})();
let prog=load();
$("tgl").onclick=()=>{const h=document.body.classList.toggle("hide-en");$("tgl").textContent=h?"Show English":"Hide English"};
function show(id){document.querySelectorAll(".scr").forEach(s=>s.classList.toggle("on",s.id===id));$("back").style.visibility=id==="home"?"hidden":"visible";$("back").dataset.to=({lv:"home",gm:"home",gp:"gm"})[id]||"lv";if(id!=="gp"&&typeof gend==="function"){gend();gend=null};window.scrollTo(0,0)}
$("back").onclick=()=>{if($("back").dataset.to==="lv")grid();show($("back").dataset.to)};
$("play").onclick=()=>{grid();show("lv")};
$("reset").onclick=()=>{if(confirm("सब फिर से शुरू करें? (Reset everything?)")){prog=Array(25).fill(0);save();grid()}};
const total=()=>prog.reduce((a,b)=>a+b,0);
function grid(){$("tot").textContent=$("tot2").textContent=total();const g=$("grid");g.innerHTML="";
prog.forEach((s,i)=>{const b=document.createElement("button");b.type="button";const open=i===0||prog[i-1]>0;
b.className=(s>0?"done":open?"open":"lock")+(i>=20?" boss":"");
if(s>0)b.innerHTML=(i+1)+"<small>"+"★".repeat(s)+"☆".repeat(3-s)+"</small>";
else if(open)b.textContent=i+1;else{b.textContent="🔒";b.disabled=true}
b.setAttribute("aria-label","लेवल "+(i+1)+(open?"":", लॉक (locked)"));
if(open)b.onclick=()=>start(i);g.appendChild(b)})}
const SWH="अ आ इ ई उ ऊ ए ओ".split(" "),MTH="ा ि ी ु ू े ो".split(" "),CSH="क ग च ज त द न प ब म र ल स ह".split(" ");
const OLD_W=[["🏠","bahay","house",["ba","hay"]],["🐟","isda","fish",["is","da"]],["🌙","buwan","moon",["bu","wan"]],["🍚","kanin","rice",["ka","nin"]],["🐱","pusa","cat",["pu","sa"]],["🐶","aso","dog",["a","so"]],["🌳","puno","tree",["pu","no"]],["☀️","araw","sun",["a","raw"]],["🥭","mangga","mango",["mang","ga"]],["🍌","saging","banana",["sa","ging"]],["⚽","bola","ball",["bo","la"]],["📖","aklat","book",["ak","lat"]]];
const WH=[["🏠","घर","house",["घ","र"]],["🐟","मछली","fish",["मछ","ली"]],["🌙","चाँद","moon",["चाँ","द"]],["🍚","चावल","rice",["चा","वल"]],["🐱","बिल्ली","cat",["बि","ल्ली"]],["🐶","कुत्ता","dog",["कु","त्ता"]],["🌳","पेड़","tree",["पे","ड़"]],["☀️","सूरज","sun",["सू","रज"]],["🥭","आम","mango",["आ","म"]],["🍌","केला","banana",["के","ला"]],["⚽","गेंद","ball",["गें","द"]],["📖","किताब","book",["कि","ताब"]]];
const HM=["फिर कोशिश करो! तुम कर सकते हो।<span class='en'>Try again! You can do it.</span>","अच्छा! और भी अच्छा कर सकते हो।<span class='en'>Good job! You can do even better.</span>","शाबाश!<span class='en'>Well done!</span>","कमाल! तुम सबसे बढ़िया हो!<span class='en'>Perfect! You are the best!</span>"];
const JK=[
["शून्य ने आठ से क्या कहा?","What did zero say to eight?","वाह, क्या बेल्ट है!","Nice belt!"],
["ऐसी क्या चीज़ है जिसमें चाबियाँ हैं पर दरवाज़ा नहीं खुलता?","What has keys but can't open a door?","पियानो! 🎹","A piano! 🎹"],
["बच्चा सीढ़ी लेकर स्कूल क्यों गया?","Why did the child take a ladder to school?","क्योंकि उसे हाई स्कूल जाना था!","Because he wanted to go to high school!"],
["कौन सा महीना 28 दिन का होता है?","Which month has 28 days?","सारे महीने! 📅","All of them! 📅"],
["बिल्ली को कंप्यूटर क्यों पसंद है? 🐱","Why does the cat love the computer?","क्योंकि उसमें चूहा (माउस) है! 🖱️","Because it has a mouse! 🖱️"],
["मुर्गी लाइब्रेरी क्यों गई? 🐔","Why did the chicken go to the library?","ताकि 'बुक! बुक! बुक!' बोल सके!","So she could say 'Book! Book! Book!'"],
["गणित की किताब उदास क्यों थी? 📘","Why was the math book sad?","क्योंकि उसमें बहुत सारी प्रॉब्लम थीं!","Because it had so many problems!"],
["कौन सी चीज़ जितना सुखाओ, उतनी गीली होती है?","What gets wetter the more it dries?","तौलिया! 🧺","A towel! 🧺"],
["कौन सी चीज़ तोड़ने के बाद ही खाई जाती है?","What is eaten only after it is broken?","अंडा! 🥚","An egg! 🥚"]];
