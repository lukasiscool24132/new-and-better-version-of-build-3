  if(v.k==="L"){const t=v.g[x%v.g.length],pl=v.seen;
   if(x%2===0)q.push({p:["सुनो, फिर अक्षर दबाओ 👂","Listen, then tap the letter"],big:"🔊",say:t[0],o:mix(t[0],pl.map(y=>y[0]),n),a:t[0],f:Z,so:0,word:t[2],en:t[0]+" = "+t[2]});
   else q.push({p:["इस अक्षर का चित्र दबाओ 👆","Tap the picture for this letter"],big:Z(t[0]),say:t[0],o:mix(t[1],pl.map(y=>y[1]),n),a:t[1],f:y=>y,so:0,word:t[2],en:t[2]+" = "+t[3]})}
  else if(v.k==="P"){const w=v.g[x%3];q.push({p:["सुनो, फिर चित्र दबाओ 👂","Listen, then tap the picture"],big:"🔊",say:w[1],o:mix(w[0],v.g.map(y=>y[0]),2),a:w[0],f:y=>y,so:0,word:w[1],en:w[1]+" = "+w[2]})}
  else if(v.k==="Y"){const c=v.rv?pick(CS):pick(LC),m=v.rv?pick(MS):v.m,a=c+m;q.push({p:["सुनो, फिर सही आवाज़ दबाओ 👂","Listen, then tap the right sound"],big:"🔊",say:a,o:mix(a,v.rv?MS.map(z=>c+z):LC.map(z=>z+m),n),a,f:y=>y,so:0,word:a})}
  else{const w=v.g[x%3],t=x%5;
   if(t===0||t===2)q.push({p:["यह कौन सा शब्द है? 👆","Which word is this?"],big:w[0],say:null,o:mix(w[1],W.map(y=>y[1]),n),a:w[1],f:y=>y,so:1,en:w[1]+" = "+w[2]});
   else if(t===4)q.push({p:["कौन सा हिस्सा छूट गया?","Which part is missing?"],big:w[0],sub:w[3][0]+" __",say:null,o:mix(w[3][1],W.map(y=>y[3][1]),n),a:w[3][1],f:y=>y,so:0,word:w[1],en:w[1]+" = "+w[2]});
   else q.push({p:["सुनो, फिर चित्र दबाओ 👂","Listen, then tap the picture"],big:"🔊",say:w[1],o:mix(w[0],W.map(y=>y[0]),n),a:w[0],f:y=>y,so:0,word:w[1],en:w[1]+" = "+w[2]})}}
 return q}
setLang(LANG);
</script>
