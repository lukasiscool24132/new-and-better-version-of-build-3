<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>पढ़ो बढ़ो! पढ़ना सीखो</title>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Bebas+Neue&family=Atkinson+Hyperlegible:wght@400;700&family=Noto+Sans+Devanagari:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#F1E3B8;--ink:#231815;--soft:#5B4A36;--card:#FFF8E1;--gold:#B8821B;--goldtxt:#fff;--lock:#6B6B6B;--red:#E8384F;--blue:#2F6BFF;--sun:#FFC93C;--r1:#FFD66B;--r2:#FFC93C;--ok:#B6F2D3;--bad:#FFD0D5;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#2A2013;--ink:#F6E9C6;--soft:#C9B88F;--card:#3A2D1B;--r1:#4A3512;--r2:#3A2A0E;--ok:#1E6B47;--bad:#7A2A36}}
:root[data-theme="dark"]{--bg:#2A2013;--ink:#F6E9C6;--soft:#C9B88F;--card:#3A2D1B;--r1:#4A3512;--r2:#3A2A0E;--ok:#1E6B47;--bad:#7A2A36}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.25rem/1.6 "Atkinson Hyperlegible","Noto Sans Devanagari",system-ui,sans-serif;min-height:100vh}
h1,h2,button,.f{font-family:"Baloo 2","Trebuchet MS",sans-serif}
h2{font-size:clamp(1.8rem,6vw,2.6rem);margin:0 0 .2em;line-height:1.1}
.en{display:block;font:400 .7em/1.3 "Atkinson Hyperlegible",system-ui,sans-serif;color:var(--soft);margin-top:.15em}
.en.i{display:inline;margin:0}
.hide-en .en{display:none}
:focus-visible{outline:4px solid var(--red);outline-offset:3px}
.scr{display:none;max-width:44rem;margin:0 auto;padding:.5rem 1rem 2rem}
.scr.on{display:block}
#bar{display:flex;justify-content:space-between;align-items:center;max-width:44rem;margin:0 auto;padding:.6rem 1rem}
button{font:800 1.4rem "Baloo 2",sans-serif;cursor:pointer;min-height:3.2rem;min-width:3.2rem;border-radius:1rem;border:3px solid var(--ink);background:var(--card);color:var(--ink);padding:.1rem 1rem;box-shadow:0 4px 0 var(--ink)}
button:active:not(:disabled){transform:translateY(4px);box-shadow:0 0 0 var(--ink)}
#bar button{font-size:1rem;min-height:2.6rem}
#back{visibility:hidden}
/* HOME */
#home.on{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:78vh;max-width:none;position:relative;overflow:hidden;background:repeating-conic-gradient(from 0deg at 50% 45%,var(--r1) 0 9deg,var(--r2) 9deg 18deg);border-top:4px solid var(--ink);border-bottom:4px solid var(--ink)}
.logo{font:800 clamp(4rem,19vw,9rem)/1.15 "Baloo 2",sans-serif;margin:.2em 0;color:#fff;-webkit-text-stroke:.07em #231815;paint-order:stroke fill;text-shadow:0 .06em 0 #231815,0 .12em 0 #E8384F;transform:rotate(-3deg)}
.tag{font-weight:700;color:#231815;background:#FFF8E1;border:3px solid #231815;border-radius:2rem;padding:.2rem 1.2rem;margin:.5rem 0 1.5rem}
.tag .en{color:#5B4A36}
.tiles{display:flex;gap:.5rem;margin-bottom:.5rem}
.tile{width:clamp(3.2rem,15vw,5rem);height:clamp(3.2rem,15vw,5rem);display:grid;place-items:center;font:800 clamp(2rem,9vw,3.4rem) "Baloo 2",sans-serif;color:#fff;border:3px solid #231815;border-radius:1rem;box-shadow:0 5px 0 #231815;animation:bob 2s ease-in-out infinite}
.tile:nth-child(1){background:#E8384F}.tile:nth-child(2){background:#2F6BFF;animation-delay:.2s}.tile:nth-child(3){background:#1E9E63;animation-delay:.4s}.tile:nth-child(4){background:#8B4FD6;animation-delay:.6s}.tile:nth-child(5){background:#E8841B;animation-delay:.8s}
@keyframes bob{50%{transform:translateY(-12px) rotate(4deg)}}
.play{font-size:clamp(1.8rem,7vw,2.6rem);background:var(--red);color:#fff;border-color:#231815;box-shadow:0 7px 0 #231815;padding:.4rem 2.2rem;min-height:4.5rem;animation:pulse 1.6s ease-in-out infinite}
@keyframes pulse{50%{transform:scale(1.06)}}
.stat{font:800 1.6rem "Baloo 2",sans-serif;background:#231815;color:#FFC93C;border-radius:2rem;padding:0 1.2rem;margin-top:1.4rem}
/* LEVELS */
#grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.5rem;margin:1rem 0}
#grid button{min-width:0;min-height:4.6rem;padding:0;display:flex;flex-direction:column;align-items:center;justify-content:center;font:400 2rem "Bebas Neue",sans-serif;line-height:1;border-radius:.8rem;box-shadow:0 5px 0 var(--ink)}
#grid button small{font-size:.8rem;letter-spacing:.1em;color:#FFE08A}
#grid .done{background:var(--gold);color:#fff;border-color:var(--ink)}
#grid .open{background:var(--card);animation:pulse 1.6s ease-in-out infinite}
#grid .lock{background:var(--lock);cursor:not-allowed;font-size:1.5rem;opacity:.95}
#grid .boss{border-style:dashed}
.small{font-size:.95rem;min-height:2.4rem;box-shadow:none}
/* PLAY */
.dots{display:flex;gap:.4rem;justify-content:center;margin:.3rem 0 1rem}
.dots i{width:1.1rem;height:1.1rem;border-radius:50%;border:3px solid var(--ink);background:var(--card)}
.dots i.d{background:var(--gold)}.dots i.c{background:var(--sun)}
.q{background:var(--card);border:3px solid var(--ink);border-radius:1.5rem;padding:1rem;text-align:center;box-shadow:0 6px 0 var(--ink)}
.q h2{font-size:1.5rem}
#big{font-size:6.5rem;line-height:1.1}
#sub{font:800 3rem "Baloo 2",sans-serif;color:var(--blue);min-height:1em}
.say{background:var(--sun);color:#231815;border-color:#231815;box-shadow:0 4px 0 #231815}
#opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(7rem,1fr));gap:.7rem;margin:1.2rem 0}
#opts button{font-size:2rem;min-height:4.4rem}
#opts .good{background:var(--ok)}#opts .bad{background:var(--bad);animation:shake .3s}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
#msg{font:800 1.7rem "Baloo 2",sans-serif;min-height:2.6rem;text-align:center}
#res{text-align:center}
.bigstars{font:800 5rem/1 "Baloo 2",sans-serif;color:var(--sun);-webkit-text-stroke:3px #231815;paint-order:stroke fill;margin:.5rem 0}
.bigstars s{text-decoration:none;color:var(--lock)}
.acts{display:flex;flex-direction:column;gap:.8rem;align-items:center;margin-top:1rem}
.jk{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:rgba(35,24,21,.7);padding:1rem;padding-top:calc(1rem + env(safe-area-inset-top,0px));padding-bottom:calc(1rem + env(safe-area-inset-bottom,0px))}
.jk[hidden]{display:none}
.jc{background:var(--card);border:4px solid var(--ink);border-radius:1.5rem;box-shadow:0 8px 0 var(--ink);max-width:28rem;width:100%;padding:1.2rem;text-align:center;animation:pop .35s;max-height:90vh;overflow:auto}
@keyframes pop{from{transform:scale(.6) rotate(-6deg);opacity:0}}
.jh{font-size:2rem;font-weight:800;color:var(--red);line-height:1.1}
.jqs{font-size:1.5rem;font-weight:700;margin:.8rem auto}
.jas{font:800 1.7rem "Baloo 2",sans-serif;color:var(--blue);min-height:1.5em;margin:.4rem auto}
.gmg{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:.9rem;margin-top:1rem}.gmg button{display:flex;flex-direction:column;align-items:center;padding:1rem .5rem;border-radius:1.5rem;line-height:1.15;font-size:1.3rem}.gmg .e{font-size:3.2rem}
.gmsg{font:800 1.5rem "Baloo 2",sans-serif;text-align:center;min-height:2.4rem}
.mg{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}.mc{min-height:5.5rem;font-size:1.6rem;padding:0}.mc.up{background:var(--sun);color:#231815}.mc.ok{background:var(--ok)}
.pic2{font-size:6rem;text-align:center}.slots{display:flex;gap:.4rem;justify-content:center;font:800 2.4rem "Baloo 2",sans-serif;margin:.5rem 0;flex-wrap:wrap}.slots span{min-width:3rem;border-bottom:4px solid var(--ink);text-align:center}
.row2{display:flex;flex-wrap:wrap;gap:.6rem;justify-content:center;margin:1rem 0}.row2 button{font-size:2rem;min-width:4rem}.row2 button:disabled{opacity:.3}
.opts2{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem;margin:1rem 0}.em{font-size:4rem;min-height:6rem}.em.good{background:var(--ok)}.em.bad{background:var(--bad)}
.sky{position:relative;height:24rem;overflow:hidden;border:3px solid var(--ink);border-radius:1.5rem;background:linear-gradient(#8EC9FF,#E8F6FF);margin-top:.5rem}
.bl{position:absolute;bottom:-6rem;width:4.6rem;height:5.6rem;border-radius:50% 50% 48% 48%;color:#fff;font-size:2rem;padding:0;box-shadow:none;animation:rise 6s linear forwards}
@keyframes rise{to{transform:translateY(-30rem)}}
#pi{font-size:2.4rem;text-align:center;font-weight:800}
.cf{position:fixed;top:-3rem;font-size:2rem;z-index:60;pointer-events:none;animation:fall 2.4s linear forwards}@keyframes fall{to{transform:translateY(115vh) rotate(540deg)}}
.lc{display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:.8rem;margin:1rem 0}.lc button{display:flex;flex-direction:column;align-items:center;padding:.8rem .3rem;border-radius:1.5rem;line-height:1.15}.lc .e{font-size:3.4rem}.lc .L{font:800 3.2rem "Baloo 2",sans-serif;color:var(--blue)}.lc .w{font:700 1.4rem "Atkinson Hyperlegible","Noto Sans Devanagari",sans-serif}.lc .t{font:400 .9rem sans-serif;color:var(--soft)}.lc button.seen{background:var(--ok)}#opts button.hint{outline:5px solid var(--sun);animation:pulse 1s infinite}
.lang{display:flex;gap:.6rem;margin:.2rem 0 1rem}.lang button{min-width:7rem;font-size:1.3rem}.lang button[aria-pressed="true"]{background:var(--blue);color:#fff}
.jbtn{margin-top:1rem;background:var(--sun);color:#231815;border-color:#231815;box-shadow:0 5px 0 #231815}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style>
</head>
<body>
<header id="bar"><button id="back" type="button" aria-label="वापस (Back)">⬅</button><span><button id="snd" type="button" aria-label="Sound">🔊</button> <button id="tgl" type="button">Hide English</button></span></header>

<section id="home" class="scr on" aria-label="Home">
  <div class="tiles" aria-hidden="true"><span class="tile">अ</span><span class="tile">आ</span><span class="tile">इ</span><span class="tile">ई</span><span class="tile">उ</span></div>
